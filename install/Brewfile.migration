# Brewfile for new Mac migration
# Generated from old Mac, pruned of unused packages

# Taps
tap "argoproj/tap"
tap "buildpacks/tap"
tap "hashicorp/tap"
tap "homebrew/bundle"
tap "mike-engel/jwt-cli"
tap "minio/stable"
tap "sfdc-falcon/cli", "git@git.soma.salesforce.com:sfdc-falcon/homebrew-cli.git"

# Core dev tools
brew "git"
brew "gh"
brew "pre-commit"
brew "shellcheck"
brew "tree"
brew "jq"
brew "yq"
brew "direnv"
brew "thefuck"
brew "the_silver_searcher"
brew "trash-cli", link: true

# Languages & build
brew "go"
brew "maven"
brew "cmake"
brew "mage"
brew "poetry"
brew "pyenv"
brew "zlib"

# Cloud & infra
brew "awscli"
brew "aws-iam-authenticator"
brew "helm"
brew "k9s"
brew "terraform-docs"
brew "tfenv"
brew "tflint"
brew "hashicorp/tap/vault"
brew "argoproj/tap/kubectl-argo-rollouts"
brew "buildpacks/tap/pack"

# Database
brew "postgresql@14"

# Security
brew "gnupg"
brew "pinentry-mac"
brew "mike-engel/jwt-cli/jwt-cli"

# Utilities
brew "gnu-tar"
brew "asdf"
brew "diffoci"
brew "sonar-scanner"
brew "minio/stable/mc"

# Salesforce
brew "sfdc-falcon/cli/falcon-cli", link: false

# GUI Apps (Casks)
cask "iterm2"
cask "cursor"
cask "visual-studio-code"
cask "docker-desktop"
cask "insomnia"
cask "1password"
cask "bitwarden"
cask "firefox"
cask "spotify"
cask "vlc"
cask "dozer"
cask "fliqlo"
cask "quip"
cask "hovrly"

# VS Code extensions
vscode "adpyke.vscode-sql-formatter"
vscode "bierner.markdown-preview-github-styles"
vscode "docker.docker"
vscode "eamodio.gitlens"
vscode "github.copilot"
vscode "github.copilot-chat"
vscode "github.vscode-pull-request-github"
vscode "golang.go"
vscode "hashicorp.terraform"
vscode "iliazeus.vscode-ansi"
vscode "mechatroner.rainbow-csv"
vscode "ms-azuretools.vscode-containers"
vscode "ms-azuretools.vscode-docker"
vscode "ms-kubernetes-tools.vscode-kubernetes-tools"
vscode "ms-python.black-formatter"
vscode "ms-python.debugpy"
vscode "ms-python.python"
vscode "ms-python.vscode-pylance"
vscode "ms-python.vscode-python-envs"
vscode "ms-vscode-remote.remote-containers"
vscode "redhat.java"
vscode "redhat.vscode-yaml"
vscode "salesforce.codegenie"
vscode "salesforce.salesforcedx-vscode-apex"
vscode "salesforce.salesforcedx-vscode-core"
vscode "samuelcolvin.jinjahtml"
vscode "sf-core-ides.coredx-workspaces-getting-started"
vscode "sf-core-ides.vscode-internal-marketplace"
vscode "tamasfe.even-better-toml"
vscode "visualstudioexptteam.intellicode-api-usage-examples"
vscode "visualstudioexptteam.vscodeintellicode"
vscode "vscjava.vscode-gradle"
vscode "vscjava.vscode-java-debug"
vscode "vscjava.vscode-java-dependency"
vscode "vscjava.vscode-java-pack"
vscode "vscjava.vscode-java-test"
vscode "vscjava.vscode-java-upgrade"
vscode "vscjava.vscode-maven"
vscode "wholroyd.jinja"
vscode "zhuangtongfa.material-theme"

# Go tools
go "github.com/unknwon/bra"
go "golang.org/dl/go1.19"
go "golang.org/x/tools/gopls"
go "github.com/magefile/mage"
go "honnef.co/go/tools/cmd/staticcheck"
go "github.com/google/wire/cmd/wire"

# Cargo
cargo "lsd"
