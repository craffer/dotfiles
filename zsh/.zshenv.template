# Machine-specific environment variables
# Copy this to ~/.dotfiles/zsh/.zshenv and fill in the paths for your machine
# Not checked into version control

# Client-user certificate paths (update after placing certs on new machine)
export CA_CERT_DIR="$HOME/dev/salesforce/other/personal/certs/client-user/ca"
export CA_CERT_FILE="$HOME/dev/salesforce/other/personal/certs/client-user/ca/cacert.pem"
export CERT_FILE="$HOME/dev/salesforce/other/personal/certs/client-user-with-ou-corp-network/client/certificates/cert.pem"
export CERT_KEY_FILE="$HOME/dev/salesforce/other/personal/certs/client-user-with-ou-corp-network/client/keys/YOUR_USERNAME.user.sfdc.net_YYYYMMDD.privkey.pem"
export CERT_FILE_WITH_KEY="$HOME/dev/salesforce/other/personal/certs/client-user-with-ou-corp-network/client/certificates/cert-with-key.pem"

# Spinnaker paths
export FALCON_HOME="$HOME/dev/salesforce/monitoring/huron-fedx/falcon"
export HURON_MODELS_REPO="$HOME/dev/salesforce/monitoring/huron-data-models"

# Auto-export Nexus credentials from Maven settings
export_nexus_credentials() {
  local maven_settings="$HOME/.m2/settings.xml"
  if [[ -f "$maven_settings" ]]; then
    local username=$(xmllint --xpath "(//*[local-name()='settings']/*[local-name()='servers']/*[local-name()='server']/*[local-name()='username']/text())[1]" "$maven_settings" 2>/dev/null)
    local password=$(xmllint --xpath "(//*[local-name()='settings']/*[local-name()='servers']/*[local-name()='server']/*[local-name()='password']/text())[1]" "$maven_settings" 2>/dev/null)

    if [[ -n "$username" && -n "$password" ]]; then
      export NEXUS_USERNAME="$username"
      export NEXUS_PASSWORD="$password"
    fi
  fi
}

# Call the function to export credentials
export_nexus_credentials
